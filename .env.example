PORT=3000
MONGODB_URI=
MONGODB_DB=cardsnap
MONGODB_TEST_DB=cardsnap_step1_test
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_TENANT_ID=

# OCR Provider Strategy: 'both' (Google Vision primary -> OCR.space fallback), 'google', or 'ocrspace'
OCR_PROVIDER_MODE=both

# Google Cloud Vision API (Server-side only — never exposed to frontend)
GOOGLE_VISION_API_KEY=

# OCR.space API (Server-side only — never exposed to frontend)
OCR_SPACE_API_KEY=

CC_CLIENT_ID=
CC_CLIENT_SECRET=
CC_REDIRECT_URI=http://localhost:3000/auth/callback
CC_LIST_NAME=General Interest
CC_CUSTOM_FIELD_LABEL=Lead Source
CC_FROM_EMAIL=
CC_FROM_NAME=
