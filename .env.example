MONGODB_DB=cardsnap
MONGODB_TEST_DB=cardsnap_step1_test
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
APP_BASE_URL=
ALLOWED_ORIGINS=
CRON_SECRET=
BACKUP_KEY=
BACKUP_OUTPUT=
RESTORE_MONGODB_URI=
RESTORE_DB=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_TENANT_ID=
INTERNAL_TEST_TENANT_ID=
INTERNAL_ALI_EMAIL=
INTERNAL_ALI_PASSWORD=
INTERNAL_ZAID_EMAIL=
INTERNAL_ZAID_PASSWORD=
INTERNAL_IBRAHIM_EMAIL=
INTERNAL_IBRAHIM_PASSWORD=
INTERNAL_HAROON_EMAIL=
INTERNAL_HAROON_PASSWORD=
INTERNAL_HASSAN_EMAIL=
INTERNAL_HASSAN_PASSWORD=

# Google Cloud Vision API (Server side only. Never expose it to the frontend.)
GOOGLE_VISION_API_KEY=
OCR_MONTHLY_CAP=900

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional local credential JSON outside the repository; preferred for local development.
