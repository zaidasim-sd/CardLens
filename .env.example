# Google Cloud Vision API (Server side only. Never expose it to the frontend.)
GOOGLE_VISION_API_KEY=
OCR_MONTHLY_CAP=900

# Server-only: share the spreadsheet with this service-account client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional local credential JSON fallback; a complete email/private-key pair takes precedence.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
APP_TIME_ZONE=UTC
# Pilot: /spreadsheets/d/<THIS_ID>/edit. No frontend Google credentials are needed.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TEST_ID=
GOOGLE_SHEET_TAB=Contacts
# Submission-only client layout: headings are on row 1, time is fixed GMT-4.
GOOGLE_SHEET_HEADER_ROW=1
GOOGLE_SHEET_CAPTURE_TIME_ZONE=Etc/GMT+4
# Legacy only: pilot resolves the numeric tab ID from GOOGLE_SHEET_TAB automatically.
GOOGLE_SHEET_TAB_ID=0
SHEET_TARGET_APPROVED=false
SHEET_REVIEWER_NAME=Hala
# Submission-only mode uses existing headers; DO NOT run configure:sheet.
# Queue/status polling is paused; prior workflow is preserved in config/pilot.json.

# PILOT: Constant Contact is disabled in config/pilot.json. Preserve these for restoration.
# Credentials are server-only; OAuth tokens are encrypted in MongoDB.
CC_ENABLED=false
CC_CLIENT_ID=
CC_CLIENT_SECRET=
CC_REDIRECT_URI=http://localhost:3000/auth/callback
CC_APP_RETURN_URL=https://localhost:5173/users
CC_LIST_NAME=
CC_CUSTOM_FIELD_LABEL=
# Reserved for a future explicitly requested email campaign; unused for contact transfer.
CC_FROM_EMAIL=
CC_FROM_NAME=

# Firebase Web Client (for Google Authentication)
FIREBASE_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

